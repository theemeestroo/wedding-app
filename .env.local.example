# Same Supabase project as Letly — isolation is by schema, not by project.
# Copy this file to .env.local and fill in the real (shared-project) values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Schema this app queries — must be exposed in Supabase dashboard →
# Project Settings → API → Exposed schemas.
NEXT_PUBLIC_APP_SCHEMA=wedding
